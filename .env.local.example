# =============================================================================
# Kak Rahma Blog — Environment Variables
# Copy this file to .env.local and fill in all values before running the app.
# NEVER commit .env.local to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — Required for all database and auth operations
# Find these in: Supabase Dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Your Supabase project URL (safe to expose — used by the browser client too)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (safe to expose — RLS is your security layer)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key — SERVER ONLY. NEVER add the NEXT_PUBLIC_ prefix.
# Grants unrestricted database access, bypassing all RLS policies.
# Used exclusively in: lib/supabase/service.ts → Draft Mode preview path.
# Find this in: Supabase Dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# Draft Mode Preview — Protects the /api/preview endpoint
# Generate with: openssl rand -hex 32
# The same value must be used in the Vercel environment and when constructing
# the preview URL in the admin dashboard.
# -----------------------------------------------------------------------------
DRAFT_PREVIEW_SECRET=generate-with-openssl-rand-hex-32

# -----------------------------------------------------------------------------
# hCaptcha — Required for the admin login form (SRS §7.2 RULE 5)
# Register at: https://www.hcaptcha.com/
# -----------------------------------------------------------------------------

# Site key (safe to expose — used in the browser-side hCaptcha widget)
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Secret key — SERVER ONLY. Used to verify captcha tokens server-side.
# NEVER add the NEXT_PUBLIC_ prefix.
HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key

# -----------------------------------------------------------------------------
# Site URL — Used for absolute URL generation in sitemap, RSS, and Open Graph
# No trailing slash. Use the production URL on Vercel (e.g. https://kakrahma.com).
# Use http://localhost:3000 for local development.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://kakrahma.com
